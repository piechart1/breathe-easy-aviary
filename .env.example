# Copy this file to .env and fill in real values once you've created the
# Sentry and PostHog projects. Telemetry silently stays off (no init, no
# network calls) for any variable left blank - see src/lib/telemetry.ts.
#
# Both of these are client-side keys, safe to ship inside the app binary
# (same category as a Stripe "publishable" key, not a secret credential).

# Sentry (sentry.io) - project Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Without a separate SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN (not set up
# here - a non-public credential, distinct from the DSN above), the "Upload
# Debug Symbols to Sentry" Xcode build phase can't authenticate and fails
# local builds. Keep this on for local dev; a real release pipeline would
# configure the org/project/token instead.
SENTRY_DISABLE_AUTO_UPLOAD=true

# PostHog (posthog.com) - Project Settings > Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=

# Only needed if you're on PostHog's EU cloud or a self-hosted instance.
# Defaults to PostHog's US cloud.
EXPO_PUBLIC_POSTHOG_HOST=

# RevenueCat (revenuecat.com) - Project Settings > API Keys. These are the
# public "app-specific" keys, one per platform - not the secret v1 API key.
# Leaves purchases uninitialized (getIsPro() always resolves false) until
# both a RevenueCat project and its App Store Connect/Play Console products
# exist - see src/lib/purchases.ts.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
