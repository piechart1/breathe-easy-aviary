# Copy this file to .env and fill in real values once you've created the
# Sentry and PostHog projects. Telemetry silently stays off (no init, no
# network calls) for any variable left blank - see src/lib/telemetry.ts.
#
# Both of these are client-side keys, safe to ship inside the app binary
# (same category as a Stripe "publishable" key, not a secret credential).

# Sentry (sentry.io) - project Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (posthog.com) - Project Settings > Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=

# Only needed if you're on PostHog's EU cloud or a self-hosted instance.
# Defaults to PostHog's US cloud.
EXPO_PUBLIC_POSTHOG_HOST=
